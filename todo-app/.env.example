# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets.

# Port the HTTP server listens on.
PORT=4000

# Where the SQLite database file lives on disk. `better-sqlite3` will create
# it automatically the first time you run `npm run migrate`.
DB_PATH=./data/todo.sqlite

# Secret used to *sign* and *verify* JWTs (see src/services/authService.js).
# In real production you'd generate this with something like
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# and never reuse it between projects.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# How many salt rounds bcrypt uses when hashing passwords. Higher = slower to
# brute-force but slower to compute. 10-12 is a reasonable default in 2025+.
BCRYPT_SALT_ROUNDS=10

# Needed only for the AI agent endpoints (POST /api/agent/chat). Get one at
# https://console.anthropic.com/. Without it, everything except the agent
# routes still works fine.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001
