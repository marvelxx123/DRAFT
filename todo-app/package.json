{
  "name": "todo-app-backend-learning",
  "version": "0.1.0",
  "description": "A deliberately 'not too simple' to-do list backend, built as a guided tour of REST API fundamentals and AI agent tool-use loops.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  }
}
