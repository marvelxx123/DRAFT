# ── 904 Garage Doors — Environment Variables ────────────────────────────────
# Copy these into Railway: Project → Variables

# REQUIRED — powers all 6 AI agents (content, social, SEO, ads, email, Google Ads)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED — password to access Mission Control at /admin.html
# Change this to something only you know
ADMIN_PASSWORD=change-this-password

# REQUIRED — your live Railway URL (set AFTER first deploy)
# Example: https://904-garage-doors.up.railway.app
SITE_URL=https://your-app.up.railway.app

# Optional — your business email (used in email agent templates)
BUSINESS_EMAIL=your@email.com

# Optional — your Facebook Business Page URL (once created)
FACEBOOK_PAGE_URL=https://facebook.com/904GarageDoors

# Railway sets PORT automatically — do not change this
PORT=3000
