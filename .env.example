# ── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Printful ─────────────────────────────────────────────────────────────────
# Get from https://www.printful.com/dashboard/settings/api
PRINTFUL_API_KEY=your_printful_api_key_here
PRINTFUL_STORE_ID=your_printful_store_id_here
# Optional: set in Printful dashboard under Webhooks
PRINTFUL_WEBHOOK_SECRET=your_printful_webhook_secret_here

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Required for autonomous agents (Content, Ad, SEO)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Mission Control ───────────────────────────────────────────────────────────
# Password to log in to /admin.html — change this before deploying!
ADMIN_PASSWORD=wearit-admin-2025

# ── Email Marketing (optional) ────────────────────────────────────────────────
# Email agent generates sequences — wire this up to actually send them
# Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG....
EMAIL_FROM=hello@wearit.com

# ── Google Analytics ──────────────────────────────────────────────────────────
# Replace G-XXXXXXXXXX in index.html with your real Measurement ID
# Get from https://analytics.google.com → Admin → Data Streams
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── App ───────────────────────────────────────────────────────────────────────
# Your public-facing URL (used for Stripe redirect URLs and sitemap)
SITE_URL=https://yourdomain.com
PORT=3000
