# ── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Printful ─────────────────────────────────────────────────────────────────
# Get from https://www.printful.com/dashboard/settings/api
PRINTFUL_API_KEY=your_printful_api_key_here
PRINTFUL_STORE_ID=your_printful_store_id_here
# Optional: set in Printful dashboard under Webhooks
PRINTFUL_WEBHOOK_SECRET=your_printful_webhook_secret_here

# ── App ───────────────────────────────────────────────────────────────────────
# Your public-facing URL (used for Stripe redirect URLs)
SITE_URL=https://yourdomain.com
PORT=3000
