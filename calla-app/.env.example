# =============================================================================
# CALLA — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (https://app.supabase.com → Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # Server-side only, never expose to client

# -----------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com → Developers → API Keys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...             # or pk_test_... for development
STRIPE_SECRET_KEY=sk_live_...                              # or sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...                            # From Stripe Dashboard → Webhooks

# Stripe Price IDs (create products in Stripe Dashboard first)
STRIPE_PRICE_ID_LITE=price_...                             # Lite plan — ~$49/mo
STRIPE_PRICE_ID_PRO=price_...                              # Pro plan — ~$99/mo
STRIPE_PRICE_ID_BUSINESS=price_...                         # Business plan — ~$199/mo
STRIPE_PRICE_ID_ELITE=price_...                            # Elite plan — ~$349/mo

# -----------------------------------------------------------------------------
# Twilio (https://console.twilio.com → Account Info)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx                           # Your Twilio number pool number (optional default)

# -----------------------------------------------------------------------------
# OpenAI (https://platform.openai.com/api-keys)
# Used for call transcript summarization and sentiment analysis
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Vapi.ai (https://dashboard.vapi.ai → API Keys)
# Used for AI voice call handling
# -----------------------------------------------------------------------------
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id             # Default phone number resource ID

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000                  # Change to https://yourcalladomain.com in production
NODE_ENV=development
