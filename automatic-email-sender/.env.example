# ── Anthropic ────────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth (Gmail) ─────────────────────────────────────────────────────
# 1. https://console.cloud.google.com → create a project
# 2. APIs & Services → Library → enable "Gmail API"
# 3. APIs & Services → OAuth consent screen → External, add your Gmail addresses as test users
# 4. APIs & Services → Credentials → Create OAuth client ID → Web application
#    Authorized redirect URI must match GOOGLE_REDIRECT_URI below exactly.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
# Optional. When set, the browser asks for this password (HTTP basic auth, any username).
# Leave empty for local use only. Always set it if you expose the app on the internet.
APP_PASSWORD=
